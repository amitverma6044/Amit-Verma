    // -------------------------------------------------------------
    // 3. MAIN APPLICATION & CONTROLLER
    // -------------------------------------------------------------
    function App() {
      const [pageTitle, setPageTitle] = useState('Dynamic Programming In-Depth Guide');
      const [sections, setSections] = useState(INITIAL_SECTIONS);
      const [history, setHistory] = useState([INITIAL_SECTIONS]);
      const [historyIndex, setHistoryIndex] = useState(0);
      const [activeDevice, setActiveDevice] = useState('desktop');
      const [activeCategory, setActiveCategory] = useState(null);
      const [flyoutOpen, setFlyoutOpen] = useState(false);
      const [searchQuery, setSearchQuery] = useState('');
      const [selectedSectionId, setSelectedSectionId] = useState(null);
      const [showExportModal, setShowExportModal] = useState(false);
      const [toastMsg, setToastMsg] = useState(null);

      const pushHistory = (newSections) => {
        const nextHistory = history.slice(0, historyIndex + 1);
        nextHistory.push(newSections);
        setHistory(nextHistory);
        setHistoryIndex(nextHistory.length - 1);
        setSections(newSections);
      };

      const handleUndo = () => {
        if (historyIndex > 0) {
          setHistoryIndex(historyIndex - 1);
          setSections(history[historyIndex - 1]);
          triggerToast('Action undone');
        }
      };

      const handleRedo = () => {
        if (historyIndex < history.length - 1) {
          setHistoryIndex(historyIndex + 1);
          setSections(history[historyIndex + 1]);
          triggerToast('Action redone');
        }
      };

      const triggerToast = (msg) => {
        setToastMsg(msg);
        setTimeout(() => setToastMsg(null), 2500);
      };

      const handleCategoryClick = (catId) => {
        if (activeCategory === catId && flyoutOpen) {
          setFlyoutOpen(false);
          setActiveCategory(null);
        } else {
          setActiveCategory(catId);
          setFlyoutOpen(true);
        }
      };

      const displayedItems = useMemo(() => {
        if (searchQuery.trim()) {
          const q = searchQuery.toLowerCase();
          return CATALOG_ITEMS.filter((item) =>
            item.label.toLowerCase().includes(q) || item.category.toLowerCase().includes(q)
          );
        }
        if (!activeCategory) return [];
        return CATALOG_ITEMS.filter((item) => item.category === activeCategory);
      }, [activeCategory, searchQuery]);

      const handleInsertItem = (item) => {
        const newSec = {
          id: `sec-${Date.now()}`,
          title: item.label,
          category: item.category,
          variant: item.variant,
          settings: {
            maxWidth: '1000px',
            bgColor: '#ffffff',
            paddingY: 'py-10',
            isDark: false,
          }
        };
        const next = [...sections, newSec];
        pushHistory(next);
        setFlyoutOpen(false);
        setActiveCategory(null);
        setSelectedSectionId(newSec.id);
        triggerToast(`Added: ${item.label}`);
      };

      const handleMoveSection = (idx, dir) => {
        const targetIdx = idx + dir;
        if (targetIdx < 0 || targetIdx >= sections.length) return;
        const copy = [...sections];
        const [moved] = copy.splice(idx, 1);
        copy.splice(targetIdx, 0, moved);
        pushHistory(copy);
      };

      const handleDuplicateSection = (idx) => {
        const item = sections[idx];
        const copy = [...sections];
        copy.splice(idx + 1, 0, {
          ...item,
          id: `sec-${Date.now()}`,
          title: `${item.title} (Copy)`,
        });
        pushHistory(copy);
        triggerToast('Section duplicated');
      };

      const handleDeleteSection = (idx) => {
        const copy = sections.filter((_, i) => i !== idx);
        pushHistory(copy);
        setSelectedSectionId(null);
        triggerToast('Section deleted');
      };

      const handleUpdateSettings = (id, newSettings) => {
        const updated = sections.map((s) => (s.id === id ? { ...s, settings: { ...s.settings, ...newSettings } } : s));
        pushHistory(updated);
      };

      const getDeviceWidth = () => {
        switch (activeDevice) {
          case 'mobile': return 'max-w-[375px]';
          case 'tablet': return 'max-w-[768px]';
          case 'desktop': return 'max-w-[1140px]';
          case 'desktop-lg': return 'max-w-[1380px]';
          case 'fullview': return 'max-w-full';
          default: return 'max-w-[1140px]';
        }
      };

      const activeSection = sections.find((s) => s.id === selectedSectionId);

      return (
        <div className="flex flex-col h-screen w-screen overflow-hidden bg-slate-200">
          {/* TOAST POPUP */}
          {toastMsg && (
            <div className="fixed top-16 right-6 z-[9999] bg-slate-900 text-white text-xs font-bold px-4 py-3 rounded-xl shadow-2xl flex items-center gap-2 animate-fade-in border border-slate-700">
              <i className="bi bi-check-circle-fill text-emerald-400"></i> {toastMsg}
            </div>
          )}

          {/* 1. TOPBAR CHROME */}
          <header className="h-14 bg-white border-b border-slate-200 px-4 flex items-center justify-between z-40 flex-shrink-0">
            <div className="flex items-center gap-3 flex-1 min-w-0 max-w-md">
              <div className="flex items-center gap-2 font-bold text-xs text-brand-600 bg-brand-50 px-2.5 py-1 rounded-lg">
                <i className="bi bi-mortarboard-fill"></i> EdTech Studio
              </div>
              <div className="h-4 w-px bg-slate-200"></div>
              <input
                type="text"
                value={pageTitle}
                onChange={(e) => setPageTitle(e.target.value)}
                className="px-2.5 py-1 text-xs font-bold text-slate-800 bg-slate-50 border border-slate-200 rounded-lg hover:border-slate-300 focus:bg-white focus:border-brand-600 focus:outline-none w-full"
                placeholder="Enter Article / Topic Title..."
              />
            </div>

            {/* Middle group: Actions & Device Simulator */}
            <div className="flex items-center gap-2">
              <div className="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200">
                <button
                  onClick={handleUndo}
                  disabled={historyIndex <= 0}
                  className="p-1.5 text-slate-700 hover:bg-white disabled:opacity-30 rounded-lg text-xs"
                  title="Undo"
                >
                  <i className="bi bi-arrow-counterclockwise"></i>
                </button>
                <button
                  onClick={handleRedo}
                  disabled={historyIndex >= history.length - 1}
                  className="p-1.5 text-slate-700 hover:bg-white disabled:opacity-30 rounded-lg text-xs"
                  title="Redo"
                >
                  <i className="bi bi-arrow-clockwise"></i>
                </button>
              </div>

              <div className="h-4 w-px bg-slate-200"></div>

              {/* Viewport switch */}
              <div className="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200">
                {[
                  { id: 'desktop-lg', icon: 'bi-display', label: 'Wide (1380px)' },
                  { id: 'desktop', icon: 'bi-laptop', label: 'Article Reader (1140px)' },
                  { id: 'tablet', icon: 'bi-tablet', label: 'Tablet (768px)' },
                  { id: 'mobile', icon: 'bi-phone', label: 'Mobile (375px)' },
                  { id: 'fullview', icon: 'bi-arrows-fullscreen', label: 'Full 100%' },
                ].map((d) => (
                  <button
                    key={d.id}
                    onClick={() => setActiveDevice(d.id)}
                    className={`px-2.5 py-1 rounded-lg text-xs flex items-center gap-1 transition ${
                      activeDevice === d.id ? 'bg-white text-brand-600 font-bold shadow-sm' : 'text-slate-600 hover:text-slate-900'
                    }`}
                    title={d.label}
                  >
                    <i className={d.icon}></i>
                  </button>
                ))}
              </div>
            </div>

            {/* Right actions */}
            <div className="flex items-center gap-2">
              <button
                onClick={() => setShowExportModal(true)}
                className="px-3.5 py-1.5 text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg flex items-center gap-1.5 transition"
              >
                <i className="bi bi-code-slash"></i> Export Article HTML
              </button>
              <button
                onClick={() => triggerToast('Article published to course syllabus!')}
                className="px-4 py-1.5 text-xs font-bold bg-brand-600 hover:bg-brand-500 text-white rounded-lg shadow-sm flex items-center gap-1.5 transition"
              >
                <i className="bi bi-send-check"></i> Publish
              </button>
            </div>
          </header>

          {/* 2. BODY LAYOUT */}
          <div className="flex flex-1 overflow-hidden relative">
            {/* LEFT RAIL: EdTech Categories */}
            <aside className="w-56 bg-white border-r border-slate-200 flex flex-col flex-shrink-0 z-30">
              <div className="p-3 border-b border-slate-100">
                <div className="relative">
                  <i className="bi bi-search absolute left-3 top-2.5 text-xs text-slate-400"></i>
                  <input
                    type="search"
                    value={searchQuery}
                    onChange={(e) => {
                      setSearchQuery(e.target.value);
                      if (e.target.value.trim()) setFlyoutOpen(true);
                    }}
                    placeholder="Search article blocks..."
                    className="w-full pl-8 pr-3 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:border-brand-500 focus:bg-white"
                  />
                </div>
              </div>

              <div className="px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-slate-400">
                EdTech Blocks ({SIDEBAR_CATEGORIES.length})
              </div>

              <div className="flex-1 overflow-y-auto p-2 grid grid-cols-2 gap-1.5">
                {SIDEBAR_CATEGORIES.map((cat) => {
                  const isActive = activeCategory === cat.id && flyoutOpen;
                  return (
                    <button
                      key={cat.id}
                      onClick={() => handleCategoryClick(cat.id)}
                      className={`flex flex-col items-center justify-center p-2.5 rounded-xl border text-center transition ${
                        isActive
                          ? 'bg-brand-50 border-brand-500 text-brand-600 shadow-sm font-bold'
                          : 'bg-white border-slate-100 hover:bg-slate-50 text-slate-600 hover:border-slate-200'
                      }`}
                    >
                      <i className={`text-xl mb-1 ${cat.icon}`}></i>
                      <span className="text-[11px] leading-tight line-clamp-1">{cat.label}</span>
                    </button>
                  );
                })}
              </div>
            </aside>

            {/* FLYOUT DRAWER */}
            <div
              className={`absolute top-0 bottom-0 left-56 w-[700px] max-w-[85vw] bg-white border-r border-slate-200 shadow-2xl z-30 flex flex-col transition-transform duration-300 ease-out ${
                flyoutOpen ? 'translate-x-0' : '-translate-x-full pointer-events-none'
              }`}
            >
              <div className="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                <div>
                  <h3 className="text-sm font-bold text-slate-900 capitalize">
                    {searchQuery ? `Search: "${searchQuery}"` : activeCategory?.replace('-', ' ')}
                  </h3>
                  <span className="text-xs text-slate-400">{displayedItems.length} templates available for this educational module</span>
                </div>
                <button
                  onClick={() => {
                    setFlyoutOpen(false);
                    setActiveCategory(null);
                    setSearchQuery('');
                  }}
                  className="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-slate-800 hover:bg-slate-200"
                >
                  <i className="bi bi-x-lg"></i>
                </button>
              </div>

              <div className="flex-1 overflow-y-auto p-5 grid grid-cols-2 gap-4">
                {displayedItems.length === 0 ? (
                  <div className="col-span-full py-16 text-center text-slate-400">
                    <i className="bi bi-inbox text-3xl mb-2 block"></i>
                    No article templates matched your search.
                  </div>
                ) : (
                  displayedItems.map((item) => (
                    <div
                      key={item.id}
                      onClick={() => handleInsertItem(item)}
                      className="group cursor-pointer rounded-xl border border-slate-200 hover:border-brand-500 hover:shadow-lg transition bg-slate-50 overflow-hidden flex flex-col"
                    >
                      <div className="h-32 bg-slate-100 overflow-hidden border-b border-slate-200 relative">
                        <img src={item.thumbnail} alt={item.label} className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200" />
                        <div className="absolute inset-0 bg-brand-600/0 group-hover:bg-brand-600/10 transition-colors flex items-center justify-center">
                          <span className="opacity-0 group-hover:opacity-100 bg-white font-bold text-brand-600 text-xs px-2.5 py-1 rounded-md shadow-md transition">
                            + Insert Section
                          </span>
                        </div>
                      </div>
                      <div className="p-2.5 bg-white">
                        <h4 className="text-xs font-semibold text-slate-800 truncate">{item.label}</h4>
                      </div>
                    </div>
                  ))
                )}
              </div>
            </div>

            {/* BACKDROP */}
            {flyoutOpen && (
              <div
                onClick={() => {
                  setFlyoutOpen(false);
                  setActiveCategory(null);
                }}
                className="absolute inset-0 bg-slate-900/10 z-20"
              ></div>
            )}

            {/* CENTER CANVAS */}
            <main className="flex-1 overflow-y-auto p-6 md:p-8 flex justify-center bg-slate-100">
              <div className={`w-full canvas-device-frame ${getDeviceWidth()} mx-auto`}>
                <div className="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden min-h-[85vh]">
                  {sections.map((section, idx) => {
                    const isSelected = selectedSectionId === section.id;
                    return (
                      <div
                        key={section.id}
                        onClick={(e) => {
                          e.stopPropagation();
                          setSelectedSectionId(section.id);
                        }}
                        className={`relative group border-2 transition-all ${
                          isSelected ? 'border-brand-500 ring-2 ring-brand-200' : 'border-transparent hover:border-slate-300'
                        } ${section.settings.paddingY}`}
                        style={{ backgroundColor: section.settings.bgColor }}
                      >
                        {/* Hover Section Toolbar */}
                        <div
                          className={`absolute top-2 right-4 z-20 flex items-center gap-1 bg-white/95 backdrop-blur border border-slate-200 shadow-md px-2 py-1 rounded-lg transition-opacity ${
                            isSelected ? 'opacity-100' : 'opacity-0 group-hover:opacity-100'
                          }`}
                        >
                          <span className="text-[10px] font-mono text-slate-400 mr-1.5 uppercase">{section.category}</span>
                          <button
                            onClick={(e) => { e.stopPropagation(); handleMoveSection(idx, -1); }}
                            disabled={idx === 0}
                            className="w-6 h-6 rounded flex items-center justify-center hover:bg-slate-100 disabled:opacity-20 text-slate-600"
                            title="Move Up"
                          >
                            <i className="bi bi-arrow-up"></i>
                          </button>
                          <button
                            onClick={(e) => { e.stopPropagation(); handleMoveSection(idx, 1); }}
                            disabled={idx === sections.length - 1}
                            className="w-6 h-6 rounded flex items-center justify-center hover:bg-slate-100 disabled:opacity-20 text-slate-600"
                            title="Move Down"
                          >
                            <i className="bi bi-arrow-down"></i>
                          </button>
                          <button
                            onClick={(e) => { e.stopPropagation(); handleDuplicateSection(idx); }}
                            className="w-6 h-6 rounded flex items-center justify-center hover:bg-slate-100 text-slate-600"
                            title="Duplicate"
                          >
                            <i className="bi bi-copy"></i>
                          </button>
                          <button
                            onClick={(e) => { e.stopPropagation(); handleDeleteSection(idx); }}
                            className="w-6 h-6 rounded flex items-center justify-center hover:bg-red-50 text-red-500"
                            title="Delete"
                          >
                            <i className="bi bi-trash"></i>
                          </button>
                        </div>

                        {/* Section Content */}
                        <div
                          className="mx-auto px-4 sm:px-6"
                          style={{ maxWidth: section.settings.maxWidth }}
                        >
                          <RenderSectionBlock section={section} />
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            </main>

            {/* RIGHT INSPECTOR */}
            {activeSection && (
              <aside className="w-72 bg-white border-l border-slate-200 flex flex-col z-30 animate-fade-in shadow-lg">
                <div className="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                  <div className="flex items-center gap-2">
                    <i className="bi bi-sliders text-brand-600"></i>
                    <h3 className="text-xs font-bold text-slate-900 uppercase tracking-wider">Article Block Settings</h3>
                  </div>
                  <button
                    onClick={() => setSelectedSectionId(null)}
                    className="w-6 h-6 rounded hover:bg-slate-200 text-slate-400 text-xs flex items-center justify-center"
                  >
                    <i className="bi bi-x"></i>
                  </button>
                </div>

                <div className="flex-1 overflow-y-auto p-4 space-y-6 text-xs">
                  <div>
                    <label className="text-[10px] font-bold uppercase text-slate-400 block mb-1">Block Title</label>
                    <input
                      type="text"
                      value={activeSection.title}
                      onChange={(e) => handleUpdateSettings(activeSection.id, { title: e.target.value })}
                      className="w-full px-3 py-1.5 border border-slate-200 rounded-lg text-slate-800 font-semibold focus:outline-none focus:border-brand-500"
                    />
                  </div>

                  <div>
                    <label className="text-[10px] font-bold uppercase text-slate-400 block mb-2">Reading Container Width</label>
                    <div className="grid grid-cols-3 gap-1.5">
                      {['800px', '1000px', '1200px'].map((w) => (
                        <button
                          key={w}
                          onClick={() => handleUpdateSettings(activeSection.id, { maxWidth: w })}
                          className={`py-1.5 rounded-lg border text-center font-bold ${
                            activeSection.settings.maxWidth === w
                              ? 'bg-brand-600 text-white border-brand-600'
                              : 'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100'
                          }`}
                        >
                          {w}
                        </button>
                      ))}
                    </div>
                  </div>

                  <div>
                    <label className="text-[10px] font-bold uppercase text-slate-400 block mb-2">Background Accent</label>
                    <div className="flex items-center gap-2">
                      {['#ffffff', '#f8fafc', '#f0fdf4', '#eff6ff', '#fefce8'].map((hex) => (
                        <button
                          key={hex}
                          onClick={() => handleUpdateSettings(activeSection.id, { bgColor: hex })}
                          className={`w-7 h-7 rounded-full border shadow-sm transition-transform ${
                            activeSection.settings.bgColor === hex ? 'scale-125 ring-2 ring-brand-500 ring-offset-2' : 'hover:scale-110'
                          }`}
                          style={{ backgroundColor: hex }}
                        />
                      ))}
                    </div>
                  </div>

                  <div>
                    <label className="text-[10px] font-bold uppercase text-slate-400 block mb-2">Vertical Spacing</label>
                    <div className="grid grid-cols-4 gap-1.5">
                      {[
                        { label: 'Tight', val: 'py-4' },
                        { label: 'Normal', val: 'py-8' },
                        { label: 'Relaxed', val: 'py-12' },
                        { label: 'Large', val: 'py-16' },
                      ].map((p) => (
                        <button
                          key={p.val}
                          onClick={() => handleUpdateSettings(activeSection.id, { paddingY: p.val })}
                          className={`py-1.5 rounded-lg border font-bold text-center ${
                            activeSection.settings.paddingY === p.val
                              ? 'bg-brand-600 text-white border-brand-600'
                              : 'bg-slate-50 text-slate-700 border-slate-200'
                          }`}
                        >
                          {p.label}
                        </button>
                      ))}
                    </div>
                  </div>

                  <div className="p-3 bg-indigo-50/60 rounded-xl border border-indigo-100 text-indigo-900">
                    <span className="font-bold block mb-1">EdTech Publishing Tip:</span>
                    Articles with structured Table of Contents and an inline Knowledge Check have 45% higher student completion rates.
                  </div>
                </div>
              </aside>
            )}
          </div>

          {/* 3. HTML EXPORT MODAL */}
          {showExportModal && (
            <div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
              <div className="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-3xl overflow-hidden flex flex-col max-h-[85vh]">
                <div className="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                  <div className="flex items-center gap-2">
                    <i className="bi bi-file-earmark-code text-brand-600 text-lg"></i>
                    <h3 className="font-bold text-sm text-slate-900">Export Self-Contained Article HTML</h3>
                  </div>
                  <button onClick={() => setShowExportModal(false)} className="text-slate-400 hover:text-slate-600">
                    <i className="bi bi-x-lg"></i>
                  </button>
                </div>
                <div className="p-4 flex-1 overflow-hidden flex flex-col">
                  <p className="text-xs text-slate-500 mb-2">
                    Ready-to-deploy responsive EdTech article template formatted with Tailwind CSS:
                  </p>
                  <textarea
                    readOnly
                    value={`<!-- Generated with EduForge: ${pageTitle} -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>${pageTitle}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://cdn.tailwindcss.com"><\/script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-slate-50 text-slate-900 font-sans antialiased">
  <article class="w-full">
${sections
  .map(
    (s) => `    <section id="${s.id}" class="w-full ${s.settings.paddingY}" style="background-color: ${s.settings.bgColor}">
      <div class="mx-auto px-4" style="max-width: ${s.settings.maxWidth}">
        <!-- EdTech Module: ${s.title} [${s.variant}] -->
      </div>
    </section>`
  )
  .join('\n')}
  </article>
</body>
</html>`}
                    className="w-full flex-1 p-3 bg-slate-900 text-emerald-400 font-mono text-xs rounded-xl focus:outline-none resize-none"
                    rows={16}
                  ></textarea>
                </div>
                <div className="p-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-2">
                  <button
                    onClick={() => {
                      navigator.clipboard.writeText(document.querySelector('textarea').value);
                      triggerToast('Article HTML copied to clipboard!');
                    }}
                    className="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs rounded-lg shadow transition"
                  >
                    <i className="bi bi-clipboard mr-1"></i> Copy Article Code
                  </button>
                  <button
                    onClick={() => setShowExportModal(false)}
                    className="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold text-xs rounded-lg transition"
                  >
                    Close
                  </button>
                </div>
              </div>
            </div>
          )}
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>